# Copy this file to .env and fill in real values before running the app.
# NEVER commit your real .env file.

# Postgres connection string. For a free hosted database, create one at
# https://neon.tech (or any other Postgres host) and paste its connection
# string here — it works both for local development and for a deployed
# copy of the app (e.g. on Vercel), so there is only ever one database to
# keep in sync. Example shape:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random string used to encrypt the session cookie. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# The single coach account used to sign in.
COACH_EMAIL="you@example.com"

# EITHER set a bcrypt hash (recommended, especially for anything other than
# a local machine you fully control) generated with:
#   node scripts/hash-password.mjs "your-password"
# IMPORTANT: in a real .env file, escape every '$' in the hash as '\$'
# (Next.js expands unescaped $VAR-looking sequences in .env files, which
# corrupts bcrypt hashes such as $2a$12$... if left unescaped).
COACH_PASSWORD_HASH=""

# ...OR, for the simplest possible local setup, set a plaintext password
# instead (only use this on a machine you trust — leave COACH_PASSWORD_HASH
# blank if you use this):
COACH_PASSWORD=""
